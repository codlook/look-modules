use db;
use string;
use date;
use array;
use type;

// migrate — a tiny, honest schema-migration runner for LOOK.
// No ORM, no magic: you pass an ordered list of migrations as plain data and
// migrate_run applies the not-yet-applied ones inside a transaction, recording
// each in a tracking table. SQL stays SQL — nothing is hidden.
//
// A migration is an assoc: ["id" => "0001_init", "up" => "CREATE TABLE ..."]
//   id : unique, sortable identifier. Migrations are applied in array order.
//   up : SQL to bring the schema forward. Multiple statements may be separated
//        by ';' (each is run in turn).
//
// migrate_run($conn, $migrations)      -> [applied_id, ...]   newly applied, in order
// migrate_rollback($conn, $migrations) -> id | ""             undo the last applied one
// migrate_status($conn, $migrations)   -> [["id"=>.., "applied"=>bool], ...]
// migrate_applied($conn)               -> [id, ...]            already-applied ids
// migrate_cli($conn, $migrations)      -> (prints)  env MIGRATE_CMD = up|down|status
//
// A migration may also carry an optional "down" body for rollback:
//   ["id"=>"0002_posts", "up"=>"CREATE TABLE posts (...)", "down"=>"DROP TABLE posts"]
//
// Terminal use (no artisan needed): put your migrations in a small .lk runner and
// call migrate_cli; then MIGRATE_CMD=up|down|status lk migrate.lk.
//
// The tracking table (_look_migrations) is created on first use. Its DDL uses
// only VARCHAR columns so the same code runs on MySQL, PostgreSQL and SQLite.

function migrate__ensure($conn) {
    db::exec($conn, "CREATE TABLE IF NOT EXISTS _look_migrations (id VARCHAR(255) PRIMARY KEY, applied_at VARCHAR(32))", []);
}

function migrate__is_applied($conn, $id) {
    $n = db::col($conn, "SELECT COUNT(*) FROM _look_migrations WHERE id=?", [$id]);
    return $n > 0;
}

// Normalise a migration body to a list of statements. A body is either one SQL
// string, or an array of SQL strings for multiple statements — EXPLICIT, no ';'
// parsing (a ';' inside a string literal or a trigger body must never split).
function migrate__statements($body) {
    if (type::is_array($body)) {
        return $body;
    }
    return [$body];
}

// Run every statement in a body, skipping blank ones (so an empty "down" is a no-op).
function migrate__exec_all($conn, $body) {
    foreach (migrate__statements($body) as $stmt) {
        if (string::len(string::trim($stmt)) > 0) {
            db::exec($conn, $stmt, []);
        }
    }
}

function migrate_applied($conn) {
    migrate__ensure($conn);
    $rows = db::query($conn, "SELECT id FROM _look_migrations ORDER BY id", []);
    $out = [];
    foreach ($rows as $r) {
        push($out, $r["id"]);
    }
    return $out;
}

function migrate_run($conn, $migrations) {
    migrate__ensure($conn);
    $applied = [];
    foreach ($migrations as $m) {
        $id = $m["id"];
        if (migrate__is_applied($conn, $id)) {
            continue;
        }
        db::begin($conn);
        try {
            migrate__exec_all($conn, $m["up"]);
            db::exec($conn, "INSERT INTO _look_migrations (id, applied_at) VALUES (?, ?)", [$id, date::now()]);
            db::commit($conn);
        } catch ($e) {
            db::rollback($conn);
            throw "migrate: '" . $id . "' failed: " . error::message($e);
        }
        push($applied, $id);
    }
    return $applied;
}

function migrate_status($conn, $migrations) {
    migrate__ensure($conn);
    $out = [];
    foreach ($migrations as $m) {
        push($out, ["id" => $m["id"], "applied" => migrate__is_applied($conn, $m["id"])]);
    }
    return $out;
}

// Undo the most recently applied migration: run its "down" body (if any) and drop
// its tracking row, in one transaction. Returns the rolled-back id, or "" if there
// was nothing applied. A migration with no "down" is simply un-tracked.
function migrate_rollback($conn, $migrations) {
    migrate__ensure($conn);
    $applied = migrate_applied($conn);
    if (count($applied) == 0) {
        return "";
    }
    $last = $applied[count($applied) - 1];
    // A missing "down" is a mistake (silent un-track hides schema drift); an explicit
    // "down" => "" means "intentionally irreversible" (just un-track, run nothing).
    $has_down = false;
    $down = "";
    foreach ($migrations as $m) {
        if ($m["id"] == $last && array::contains(array::keys($m), "down")) {
            $has_down = true;
            $down = $m["down"];
        }
    }
    if (!$has_down) {
        throw "migrate: cannot roll back '" . $last . "': no down defined (use \"down\" => \"\" if it is intentionally irreversible)";
    }
    db::begin($conn);
    try {
        migrate__exec_all($conn, $down);
        db::exec($conn, "DELETE FROM _look_migrations WHERE id=?", [$last]);
        db::commit($conn);
    } catch ($e) {
        db::rollback($conn);
        throw "migrate: rollback '" . $last . "' failed: " . error::message($e);
    }
    return $last;
}

// Terminal entry point: dispatch on the first CLI argument (up|down|status,
// default up) and print a human-readable result. A one-line .lk runner becomes a
// real command:  lk migrate.lk up | lk migrate.lk down | lk migrate.lk status
// (requires a LOOK with args(); on older builds pass the command via the MIGRATE_CMD
// env var as a fallback.)
function migrate_cli($conn, $migrations) {
    // args() is the real path (lk migrate.lk up). On a LOOK without args() it throws;
    // we catch that and fall back to the MIGRATE_CMD env var, so this one runner works
    // on both new and old runtimes.
    $a = [];
    try {
        $a = args();
    } catch ($e) {
        $a = [];
    }
    $cmd = "up";
    if (count($a) > 0) {
        $cmd = $a[0];
    } else {
        $cmd = env("MIGRATE_CMD", "up");
    }
    if ($cmd == "status") {
        print("Migration status:");
        foreach (migrate_status($conn, $migrations) as $s) {
            $mark = "pending";
            if ($s["applied"]) {
                $mark = "applied";
            }
            print("  [" . $mark . "] " . $s["id"]);
        }
        return;
    }
    if ($cmd == "down" || $cmd == "rollback") {
        $id = migrate_rollback($conn, $migrations);
        if (string::len($id) == 0) {
            print("Nothing to roll back.");
        } else {
            print("Rolled back: " . $id);
        }
        return;
    }
    $done = migrate_run($conn, $migrations);
    if (count($done) == 0) {
        print("Already up to date.");
    } else {
        print("Applied " . count($done) . " migration(s):");
        foreach ($done as $id) {
            print("  + " . $id);
        }
    }
}
